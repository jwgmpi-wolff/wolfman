{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wolfman",
  "version": "1.0.0",
  "identifier": "org.wolffentp.wolfman",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "title": "Wolfman",
        "url": "overlay.html",
        "width": 720,
        "height": 460,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../../../wolfman-dist/**/*": "wolfman-dist/",
      "../../../packages/protocol/dist/**/*": "node_modules/@wolfman/protocol/dist/",
      "../../../packages/protocol/package.json": "node_modules/@wolfman/protocol/package.json",
      "../runtime/node_modules/**/*": "node_modules/"
    }
  }
}
