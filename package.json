{
  "name": "wolfman",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personal cross-device AI orchestrator. Discovers the AI apps already on your devices and routes every request to a live one. No mocks, no canned answers.",
  "author": "Jerry Wolff",
  "workspaces": [
    "packages/*",
    "core",
    "daemon"
  ],
  "scripts": {
    "build": "npm run policy:check && tsc -b packages/protocol/tsconfig.json && tsc -b tsconfig.json",
    "policy:check": "node scripts/policy-check.mjs",
    "discover": "node wolfman-dist/core/src/cli.js discover",
    "ask": "node wolfman-dist/core/src/cli.js",
    "voice": "node wolfman-dist/core/src/cli.js voice",
    "daemon": "node wolfman-dist/daemon/src/index.js",
    "test:integration": "node --test --test-name-pattern=@integration wolfman-dist/core/src/**/*.test.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "bonjour-service": "^1.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
