{
  "name": "wolfman",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A private, local-first financial and personal assistant.",
  "author": "Jerry Wolff",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "electron": "electron .",
    "dist:windows": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "icons": "node scripts/generate-icons.mjs"
  },
  "build": {
    "appId": "org.wolffentp.wolfman",
    "productName": "Wolfman",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/wolfman-icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/wolfman-icon-512.png",
      "category": "Finance",
      "maintainer": "Jerry Wolff <geraldwolff@wolffentp.org>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@azure/communication-sms": "^1.2.0-beta.4",
    "@azure/msal-browser": "^5.19.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^9.0.1-dev-20260305T153051.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
