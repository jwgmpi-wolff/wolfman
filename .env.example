# Public browser configuration only. Never use a Supabase service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Microsoft Entra SPA registration. No client secret belongs in this app.
VITE_MICROSOFT_CLIENT_ID=your-public-application-client-id
VITE_MICROSOFT_TENANT_ID=common
