# Public browser configuration only. Never use a Supabase service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Microsoft Entra SPA registration. No client secret belongs in this app.
VITE_MICROSOFT_CLIENT_ID=your-public-application-client-id
VITE_MICROSOFT_TENANT_ID=common

# Server-side only (no VITE_ prefix) — never bundled into client JS. Used by the dev-only SMS relay.
# Get this from Azure Communication Services > Keys. Never commit the real value.
ACS_SMS_CONNECTION_STRING=endpoint=https://your-acs-resource.communication.azure.com/;accesskey=your-access-key
ACS_SMS_FROM_NUMBER=+15551234567

# Server-side only (no VITE_ prefix) — used by the dev-only places/business-lookup relay.
# Get this from your Azure Maps account > Authentication.
AZURE_MAPS_KEY=your-azure-maps-primary-key
